# csc-backend — copy to .env and run `pnpm --filter csc-backend start:dev`.
# Backs the CSC job board that is served through the LINE mini-app (apps/csc-liff).
# Optional for the main map: skip this app if you are only working on the map.
#
# Everything here is a throwaway local value. Never reuse it in a deployment.

PORT=3001

# Browsers allowed to call this service. "*" is local-dev only.
CLIENT_URL="*"

# === MongoDB (docker compose) ===
MONGO_URI="mongodb://thaieconomap:thaieconomap@localhost:27017/?authSource=admin"
MONGO_DATABASE_NAME="csc"

# === MinIO / S3 (docker compose) ===
MINIO_ENDPOINT="localhost"
MINIO_FILE_ENDPOINT="http://localhost:9000"
MINIO_PORT=9000
MINIO_SSL=false
MINIO_ACCESS_KEY="thaieconomap"
MINIO_SECRET_KEY="thaieconomap"
MINIO_REGION="us-east-1"
MINIO_BUCKET="csc"
MINIO_BUCKET_RECYCLE="csc-recycle"

# === Service-to-service auth ===
# Must match the gateway's CHIAL_SHARE_API_KEY / CHIAL_SHARE_API_SECRET.
API_KEY="local-dev-csc-key"
API_KEY_SECRET="local-dev-csc-secret"

# === JWT ===
JWT_ACCESS_SECRET="local-dev-csc-access-secret-change-me"
JWT_ACCESS_EXPIRATION_TIME="3d"
JWT_REFRESH_SECRET="local-dev-csc-refresh-secret-change-me"
JWT_REFRESH_EXPIRATION_TIME="7d"

# === LINE ===
# Placeholders are fine until you want to test the real LINE login.
# Create a Login channel and a LIFF app at https://developers.line.biz/
LINE_CLIENT_ID="0000000000"
LINE_LOGIN_CHANNEL_SECRET="unused-in-local-dev"
LINE_LOGIN_AUTH_URL="https://access.line.me/oauth2/v2.1/authorize"
LINE_LOGIN_REDIRECT_URI="http://localhost:8004/auth/callback"
LINE_LIFF_URL="http://localhost:8004"
