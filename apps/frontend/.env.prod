NEXT_PUBLIC_SERVER_URL=https://api-gateway.thaieconomap.com/
# no slash at the end for routing map url
NEXT_PUBLIC_ROUTING_MAP_URL=https://osrm.issie.dev/route/v1
# true or false (true if dev for now)
NEXT_PUBLIC_ENABLE_PUMPUANG=true

# canonical site origin, no slash at the end. Only production sets it: without it the build
# serves noindex + a disallow-all robots.txt, so dev/staging never get indexed.
NEXT_PUBLIC_SITE_URL=https://www.thaieconomap.com

# csc job board (LIFF), opened from the header "เพิ่มข้อมูล" menu
NEXT_PUBLIC_CSC_LIFF_URL=https://liff.line.me/2006756212-AdJoj0Bw

# Self-hosted Umami analytics (unset => no analytics script is loaded)
NEXT_PUBLIC_UMAMI_SRC=https://umami.issie.dev/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=87551f9f-c32e-41eb-b2dd-fcfd6ddfc392
