# thaieconomap-frontend — copy to .env and run `pnpm --filter thaieconomap-frontend dev`.
# Everything a Next.js app reads as NEXT_PUBLIC_* is compiled into the browser
# bundle, so nothing secret belongs in this file.

# The API gateway. Trailing slash matters.
NEXT_PUBLIC_SERVER_URL=http://localhost:8002/

# OSRM routing server, for "directions to this shop". No trailing slash.
# The public demo server below is rate-limited and is for development only;
# for anything beyond local use, run your own: https://project-osrm.org
NEXT_PUBLIC_ROUTING_MAP_URL=https://router.project-osrm.org/route/v1

# Show the Pumpuang (mobile street vendor) layer on the map.
NEXT_PUBLIC_ENABLE_PUMPUANG=true

# The CSC job board, served as a LINE mini-app. Opened from the
# "เพิ่มข้อมูล" menu in the header. Leave empty to hide the entry.
NEXT_PUBLIC_CSC_LIFF_URL=http://localhost:8004

# Canonical public origin, no trailing slash. Only a real production deploy
# should set this: without it the build emits noindex plus a disallow-all
# robots.txt, which is what you want for local, dev and staging.
# NEXT_PUBLIC_SITE_URL=

# Optional: self-hosted Umami analytics. Unset either one and no analytics
# script is loaded at all.
# NEXT_PUBLIC_UMAMI_SRC=https://umami.example.org/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
