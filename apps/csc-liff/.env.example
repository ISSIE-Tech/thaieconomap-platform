# csc-liff — copy to .env and run `pnpm --filter csc-liff dev`.
# The CSC job board, served as a LINE mini-app (LIFF).
# NEXT_PUBLIC_* values are compiled into the browser bundle: nothing secret here.

# LIFF app id, from the LINE developers console. A placeholder is fine when
# you open the app directly in a browser instead of inside LINE.
NEXT_PUBLIC_LIFF_ID=0000000000-00000000

# Base URL of csc-backend. (The name says API_KEY; it is a URL.)
NEXT_PUBLIC_API_KEY="http://localhost:3001"

# Where uploaded images are served from. Must match csc-backend's MinIO origin;
# Next.js only optimises images from this host.
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000
