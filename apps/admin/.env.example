# thaieconomap-admin — copy to .env and run `pnpm --filter thaieconomap-admin dev`.
# NEXT_PUBLIC_* values are compiled into the browser bundle: nothing secret here.

NEXT_PUBLIC_BASE_PATH=''

# The API gateway. Trailing slash matters.
NEXT_PUBLIC_SERVER_URL=http://localhost:8002/

# Where uploaded images are served from. Matches the MinIO service in
# the repo-root docker-compose.yml.
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000

# Optional: self-hosted Umami analytics. Unset either one and no analytics
# script is loaded at all.
# NEXT_PUBLIC_UMAMI_SRC=https://umami.example.org/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
