# thaieconomap-backend — copy to .env and run `pnpm --filter thaieconomap-backend dev`.
# Defaults match the services in the repo-root docker-compose.yml.
#
# Everything here is a throwaway local value. Never reuse it in a deployment.

# === App ===
PORT=8003
NODE_ENV="development"
TZ="Asia/Bangkok"
OTEL_SERVICE_NAME="thaieconomap-backend"

# === MongoDB (docker compose) ===
MONGO_URI="mongodb://thaieconomap:thaieconomap@localhost:27017/thaieconomap?authSource=admin"

# === Redis (docker compose, host port 6380) ===
REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_PASSWORD="thaieconomap"
REDIS_USE_TLS="false"

# === MinIO / S3 (docker compose) ===
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="thaieconomap"
MINIO_SECRET_KEY="thaieconomap"
MINIO_BUCKET="thaieconomap"
MINIO_USE_SSL="false"
MINIO_REGION="us-east-1"

# === Service-to-service auth ===
# The gateway signs its calls to this service with an HMAC of API_KEY using
# API_KEY_SECRET, so these two must match the gateway's
# THAIECONOMAP_API_KEY / THAIECONOMAP_API_SECRET exactly.
API_KEY="local-dev-backend-key"
API_KEY_SECRET="local-dev-backend-secret"

# Calls in the other direction, backend -> gateway. These must match the
# gateway's own API_KEY / API_KEY_SECRET.
GATEWAY_API="http://localhost:8002"
GATEWAY_API_KEY="local-dev-gateway-key"
GATEWAY_API_SECRET="local-dev-gateway-secret"

# === JWT ===
# Generate your own for anything shared: `openssl rand -hex 32`
APP_JWT_ACCESS_TOKEN_SECRET="local-dev-access-token-secret-change-me"
APP_JWT_ACCESS_TOKEN_EXPIRATION_TIME="1d"
APP_JWT_REFRESH_TOKEN_SECRET="local-dev-refresh-token-secret-change-me"
APP_JWT_REFRESH_TOKEN_EXPIRATION_TIME="7d"

SESSION_SECRET="local-dev-session-secret-change-me"

# === SMS (ThaiBulkSMS) — sends the vendor login OTP ===
# No account needed locally: use the bypass pair below instead of a real SMS.
THAIBULKSMS_APP_KEY="unused-in-local-dev"
THAIBULKSMS_APP_SECRET="unused-in-local-dev"
THAIBULKSMS_API_URL="https://api.thaibulksms.com/enterprise/v2"

# Log in as this phone number with this OTP without sending an SMS.
BYPASS_PUMPUANG_PHONE_NUMBER="0800000000"
BYPASS_PUMPUANG_OTP="123456"

# === External services ===
# TamSang TamSong — a partner data source. Local dev never calls it.
TAMSANG_TAMSONG_API="https://example.invalid/tamsang-tamsong"
TAMSANG_TAMSONG_SECRET="unused-in-local-dev"

# csc-backend, if you are running it (apps/csc-backend, port 3001).
CHIAL_SHARE_API="http://localhost:3001"

# Optional: analytics webhook. Leave unset to disable.
# ANALYTICS_WEBHOOK_URL=
# ANALYTICS_WEBHOOK_API_KEY=

# === Push notifications (Firebase Cloud Messaging) ===
# Optional. Leave all three unset and push notifications are disabled with a
# warning in the log; everything else works. To enable, paste the values from a
# Firebase service-account JSON (keep the \n escapes in the private key).
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
