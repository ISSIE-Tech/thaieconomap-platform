# thaieconomap-gateway — copy to .env and run `pnpm --filter thaieconomap-gateway dev`.
# Defaults match the services in the repo-root docker-compose.yml.
#
# Everything here is a throwaway local value. Never reuse it in a deployment.

# === App ===
PORT=8002
NODE_ENV="development"

# === MongoDB (docker compose) ===
MONGO_URI="mongodb://thaieconomap:thaieconomap@localhost:27017/?authSource=admin"
MONGO_DB_NAME="thaieconomap"

# Browsers allowed to call the gateway: frontend (8000), admin (8001), LIFF (8004).
ALLOWED_ORIGINS="http://localhost:8000,http://localhost:8001,http://localhost:8004"

# === MinIO / S3 (docker compose) ===
MINIO_ENDPOINT="localhost"
MINIO_ACCESS_KEY="thaieconomap"
MINIO_SECRET_KEY="thaieconomap"
MINIO_BUCKET_NAME="thaieconomap"
MINIO_USE_SSL=false
MINIO_REGION="us-east-1"

# === Service-to-service auth ===
# Callers (backend, csc-backend) sign with an HMAC of API_KEY using
# API_KEY_SECRET. Must match the backend's GATEWAY_API_KEY / GATEWAY_API_SECRET.
API_KEY="local-dev-gateway-key"
API_KEY_SECRET="local-dev-gateway-secret"

# gateway -> backend. Must match the backend's API_KEY / API_KEY_SECRET.
THAIECONOMAP_API="http://localhost:8003"
THAIECONOMAP_API_KEY="local-dev-backend-key"
THAIECONOMAP_API_SECRET="local-dev-backend-secret"

# gateway -> csc-backend. Must match csc-backend's API_KEY / API_KEY_SECRET.
CHIAL_SHARE_API="http://localhost:3001"
CHIAL_SHARE_API_KEY="local-dev-csc-key"
CHIAL_SHARE_API_SECRET="local-dev-csc-secret"

# === JWT ===
# Generate your own for anything shared: `openssl rand -hex 32`
JWT_ACCESS_TOKEN_SECRET="local-dev-access-token-secret-change-me"
JWT_ACCESS_TOKEN_EXPIRATION_TIME="1d"
JWT_REFRESH_TOKEN_SECRET="local-dev-refresh-token-secret-change-me"
JWT_REFRESH_TOKEN_EXPIRATION_TIME="7d"

# Skip social login in local dev: requests are treated as this user id.
# Leave commented out to require a real LINE or Facebook login.
# BYPASS_USER_ID=

# === LINE login ===
# Local dev does not need a real LINE channel; these only have to parse.
# To use LINE for real, create a Login channel at https://developers.line.biz/
LINE_LOGIN_BASE_URL="https://api.line.me"
LINE_LOGIN_ID=0000000000
LINE_LOGIN_SECRET="unused-in-local-dev"
LINE_LOGIN_THAIECONOMAP_REDIRECT_URL="http://localhost:8000/auth/line/callback"
LINE_LOGIN_THAIECONOMAP_V2_REDIRECT_URL="http://localhost:8000/auth/line/callback"
LINE_LOGIN_THAIECONOMAP_ADMIN_REDIRECT_URL="http://localhost:8001/auth/line/callback"

# === Facebook login ===
# Same: placeholder values are fine until you want to test Facebook login.
FACEBOOK_LOGIN_BASE_URL="https://graph.facebook.com"
FACEBOOK_LOGIN_GENERATE_LINK_URL="https://www.facebook.com/v19.0/dialog/oauth"
FACEBOOK_LOGIN_ID="unused-in-local-dev"
FACEBOOK_LOGIN_SECRET="unused-in-local-dev"
FACEBOOK_LOGIN_REDIRECT_URL="http://localhost:8000/auth/facebook/callback"
