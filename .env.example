# Overrides for docker-compose.yml. Copy to .env only if you need to change
# something — every value below is already the built-in default, so a plain
# `docker compose up -d` works without this file.
#
# These are throwaway local credentials. Do not reuse them anywhere reachable
# from the internet, and never commit a filled-in .env.

TZ=Asia/Bangkok

# MongoDB — seeded with Thailand's provinces and districts on first `up`.
MONGO_ROOT_USERNAME=thaieconomap
MONGO_ROOT_PASSWORD=thaieconomap
MONGO_DB_NAME=thaieconomap
MONGO_PORT=27017

# Redis — note the host port is 6380, to stay clear of a local Redis on 6379.
REDIS_PASSWORD=thaieconomap
REDIS_PORT=6380

# MinIO — S3-compatible object storage for business and vendor photos.
MINIO_ROOT_USER=thaieconomap
MINIO_ROOT_PASSWORD=thaieconomap
MINIO_BUCKET=thaieconomap
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
